# =====================================================================
# PIRLS QuestionCraft 路線 B 環境變數範本
#
# 本檔可 commit 進 repo。實際值請複製為 .env.local（**永遠不要 commit**）。
# =====================================================================

# ---- Cloud Functions URL Base ----
# 部署 Firebase Functions 後固定為以下格式：
#   https://<region>-<projectId>.cloudfunctions.net
# 預設 region = asia-east1, projectId = pirls-questioncraft
NEXT_PUBLIC_API_BASE=https://asia-east1-pirls-questioncraft.cloudfunctions.net

# ---- GitHub Pages basePath ----
# 預設用 repo 名作為子路徑：/pirls-questioncraft
# 若以後改用自訂網域（CNAME），把這行設成空字串：
#   NEXT_PUBLIC_BASE_PATH=
# 注意：這個值在 next.config.ts 已經有 fallback 邏輯，
# 本地 dev 不用設；CI 由 .github/workflows/deploy-pages.yml 注入。
NEXT_PUBLIC_BASE_PATH=

# =====================================================================
# 後端（functions/）秘密
# 不放本檔，改用 firebase functions:secrets:set 設定到 Google Secret Manager
# 需要設定的 secret：
#   GEMINI_API_KEY  → 從 https://aistudio.google.com/app/apikey 或 gcloud 取得
#                     並加 API restrictions 限制 Generative Language API
# 設定指令：
#   firebase --account=ipad@mail2.smes.tyc.edu.tw \
#     functions:secrets:set GEMINI_API_KEY \
#     --project=pirls-questioncraft
# =====================================================================
