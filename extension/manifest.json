{
  "manifest_version": 3,
  "name": "PIRLS 閱讀題組小幫手",
  "short_name": "PIRLS 小幫手",
  "version": "0.5.2",
  "description": "框選截圖、讀取全文或反白文字，用自己的 Gemini 金鑰產生 PIRLS 閱讀理解題組，一鍵送到 PaGamO 批量上傳頁。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PIRLS 閱讀題組小幫手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://www.pagamo.org/*"
  ],
  "commands": {
    "capture-region": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "截取目前網頁畫面，到工作台框選範圍出題"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
