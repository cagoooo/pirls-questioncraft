rules_version = '2';
// 路線 B：sharedQuizzes 一律由 Cloud Functions（firebase-admin）讀寫，
// admin SDK 走 service account 會跳過 Rules，所以這裡關掉所有 client 直連。
// v0.3.0：學生作答（sharedQuizzes/{quizId}/students）含班級、座號、姓名，
// 只能經 getSubmissions 並帶老師專用金鑰讀取；任何瀏覽器都不得直連 Firestore。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
